# ──────────────────────────────────────────────────────────────────────────
# VRV Global — Integration environment variables
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# All keys are read ONLY on the server (API routes / lib/server). They are
# never exposed to the browser. The site runs fully on MOCK data until these
# are configured — see INTEGRATIONS.md.
# ──────────────────────────────────────────────────────────────────────────

# Secret that protects the sync + admin API routes. Generate a long random
# string. Cron jobs must send it as `Authorization: Bearer <CRON_SECRET>`
# (or `x-cron-secret` / `x-admin-secret` headers for admin actions).
CRON_SECRET=replace-with-a-long-random-string

# ── LinkedIn (Marketing Developer Platform — Community Management API) ──
# Requires an approved LinkedIn app with r_organization_social permission and
# an access token scoped to the VRV Global organization. If LINKEDIN_ACCESS_TOKEN
# is empty, the LinkedIn sync falls back to mock/manual data automatically.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=

# ── Commodity market data ──
# Selects which provider lib/integrations/market/providers/* is used.
# One of: manual | sgx | lme | vendor   (default: manual → mock/indicative data)
MARKET_DATA_PROVIDER=manual

# Provider credentials (only the ones relevant to MARKET_DATA_PROVIDER are used).
SGX_API_KEY=
LME_API_KEY=
# Generic licensed vendor (Refinitiv/LSEG, Bloomberg, Trading Economics,
# Nasdaq Data Link/Quandl, etc.)
MARKET_DATA_VENDOR_API_KEY=
MARKET_DATA_VENDOR_BASE_URL=

# Optional: webhook (e.g. Slack/Teams) that receives an alert if a sync fails.
INTEGRATIONS_ALERT_WEBHOOK=

# Public site URL (used for absolute links / cron self-calls).
NEXT_PUBLIC_SITE_URL=https://www.vrvglobal.com

# Design Feedback tracker (/design-feedback) — optional internal password.
# If set, the page and API require an x-feedback-password header matching this value.
# Leave empty/unset to allow open access (e.g. local development).
DESIGN_FEEDBACK_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Blog (email-OTP login) — all server-only; never exposed to the browser.
# ──────────────────────────────────────────────────────────────────────────
# The first admin. This email can always sign in (via OTP) even before any
# authors exist, and is granted the "admin" role — so it can add authors at
# /admin/blog-authors. No admin email is hardcoded anywhere in the code.
BLOG_ADMIN_EMAIL=admin@example.com

# Secret used to hash/pepper OTP codes. Generate with: openssl rand -hex 32
BLOG_SESSION_SECRET=replace-with-long-random-secret

# Email provider: use "console" locally, "resend" in production.
# For local testing, use EMAIL_PROVIDER=console — the OTP is printed in the
# server terminal (e.g. "Blog OTP for admin@example.com: 123456").
# For production, use EMAIL_PROVIDER=resend and add RESEND_API_KEY below.
EMAIL_PROVIDER=console

# Sender shown on the OTP email.
EMAIL_FROM=VRV Blog <no-reply@localhost>

# Required ONLY when EMAIL_PROVIDER=resend. Get a key at resend.com.
RESEND_API_KEY=

# Optional — durable storage for blog posts/authors/sessions (Vercel KV /
# Upstash Redis). Without these the store falls back to in-process memory
# (dev only). Add both for real persistence.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional — enables blog cover-image uploads (Vercel Blob). Without it the
# editor falls back to pasting a media URL.
# BLOB_READ_WRITE_TOKEN=

# ── Vercel setup (Project → Settings → Environment Variables) ──
# Production:
#   BLOG_ADMIN_EMAIL=admin@vrvglobal.com
#   BLOG_SESSION_SECRET=<generated-random-secret>
#   EMAIL_PROVIDER=resend
#   EMAIL_FROM=VRV Blog <onboarding@resend.dev>
#   RESEND_API_KEY=<resend-api-key>
# After verifying your domain in Resend, switch the sender to your domain:
#   EMAIL_FROM=VRV Blog <no-reply@vrvglobal.com>
